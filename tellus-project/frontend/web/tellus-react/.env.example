# Public build configuration; never put secrets in VITE_* variables.
# Same-origin /api is preferred. Production web hosting must proxy /api to Spring.
VITE_API_BASE_URL=/api
# Set to the actual ISO 4217 currency used by the catalogue before deployment.
VITE_CURRENCY=
# Development proxy only. Not included in the browser bundle.
TELLUS_API_TARGET=http://127.0.0.1:8080
